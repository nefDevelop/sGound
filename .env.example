# Copia a .env y rellena. El .env NUNCA se sube a Git.
# Puerto publicado en el host (dentro del contenedor siempre 8088).
SGOUND_PORT_HOST=8088

# OBLIGATORIA: carpeta de música del host (fuera del contenedor).
# Ejemplo: /srv/sgound/music o /home/tu-usuario/Musica
SGOUND_MUSIC_PATH_HOST=/srv/sgound/music

# Usuarios permitidos (usuario:permiso, r o rw). Solo estos pueden completar
# el setup inicial y entrar. Ejemplo con dos usuarios:
SGOUND_USERS=user:rw

# Opcionales (valores por defecto entre paréntesis):
# SGOUND_THEME_COLOR=#ff3366
# SGOUND_REPLAYGAIN=false
# SGOUND_LANGUAGE=es
# Tras proxy TLS con dominio: COOKIE_SECURE=1
# COOKIE_SECURE=0
