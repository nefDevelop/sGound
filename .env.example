# Configuración de Sgound

# Puerto en el que escuchará el servidor (fuera del contenedor)
SGOUND_PORT_HOST=8088

# Ruta absoluta a tu carpeta de música en el HOST
# Ejemplo: /home/usuario/Musica o C:\Users\usuario\Music
SGOUND_MUSIC_PATH_HOST=/home/nef734/Música

# Configuración inicial de usuarios (opcional) SGOUND_USERS=user:rw,amigo:r,admin2:rw
SGOUND_USERS=user:rw
